# Copy to .env and fill in. Never commit .env.
# Provider: gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model (gemini-3.6-flash / claude-sonnet-5)
LLM_MODEL=
LLM_MAX_TOKENS=16000
CONTEXT_TOKEN_BUDGET=20000
CONTEXT_MODE=full
RUNNER_TIMEOUT_SECONDS=10
SKIP_QUESTIONING=false
STUDENT_ID=local-student
# SQLite file for the learner model
DATABASE_PATH=labassistant.db
